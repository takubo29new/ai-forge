# Prismaで使用するPostgreSQL接続文字列
# ローカル: docker compose up -d で起動したPostgresを指す(pgvector拡張の有効化はPhase 3で使用)
DATABASE_URL="postgresql://ai_forge:ai_forge@localhost:5432/ai_forge?schema=public"

# NextAuth.js (GitHub OAuth)
# GitHub OAuth Appの作成: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="GitHub OAuth AppのClient ID"
GITHUB_CLIENT_SECRET="GitHub OAuth AppのClient Secret"
NEXTAUTH_SECRET="openssl rand -base64 32 等で生成したランダムな文字列"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API(プロンプト実行機能)
# APIキーの発行: https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY="sk-ant-..."
