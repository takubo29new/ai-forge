// Prisma schema for ai-forge
// Phase 1: プロンプト管理ツール(認証 + プロンプトCRUD + AI実行履歴・バージョン管理)
// Phase 2: AIコードレビューツール(GitHubリポジトリ連携 + PRレビュー結果の蓄積)
// 詳細は docs/db-design.md を参照

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- 認証(NextAuth.js / GitHub OAuth) ---
// NextAuth Prisma Adapter が要求する標準スキーマに準拠
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts         Account[]
  sessions         Session[]
  categories       Category[]
  prompts          Prompt[]
  executions       Execution[]
  repositories     Repository[]
  reviews          Review[]
  rateLimitBuckets RateLimitBucket[]
  errorLogs        ErrorLog[]
  documents        Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- プロンプト管理ドメイン ---

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?

  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompts Prompt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Prompt {
  id    String @id @default(cuid())
  title String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  versions PromptVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// プロンプト本文の変更履歴。編集のたびに新しいバージョンを追加し、上書きしない。
// versionNumberはアプリケーション側でmax+1を採番するため、同一Promptへの
// 同時編集リクエストは@@uniqueの衝突で片方が失敗しうる(採用時のトレードオフ。
// 詳細はdocs/db-design.md参照)。
model PromptVersion {
  id            String  @id @default(cuid())
  versionNumber Int
  content       String  @db.Text
  note          String?

  promptId String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  executions Execution[]
  reviews    Review[]

  embedding PromptVersionEmbedding?

  createdAt DateTime @default(now())

  @@unique([promptId, versionNumber])
}

enum ExecutionStatus {
  SUCCESS
  FAILED
}

// AI API実行の結果と履歴。どのプロンプトバージョンで実行したかを記録する。
// Promptへの参照はpromptVersion経由のみとし、promptIdを別途持たない
// (実行対象のバージョンと紐付くPromptが食い違う不整合を構造上防ぐ)。
model Execution {
  id String @id @default(cuid())

  promptVersionId String
  promptVersion   PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  model        String
  variables    Json?
  resultText   String?         @db.Text
  status       ExecutionStatus @default(SUCCESS)
  errorMessage String?

  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?

  review    Review?
  embedding ExecutionEmbedding?

  createdAt DateTime @default(now())

  @@index([promptVersionId])
  @@index([userId])
}

// 実行系API(プロンプト実行・AIレビュー実行・クライアントエラー報告)の
// レート制限用カウンタ。固定ウィンドウ(1時間単位)ごとにユーザー×用途
// (purpose)の呼び出し回数を数える。upsertのcount incrementはPostgres側で
// アトミックに実行されるため、「件数をSELECTしてから後でINSERTする」方式の
// ような、判定と記録の間に別リクエストが割り込むTOCTOUレースが起きない。
model RateLimitBucket {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStart DateTime
  purpose     String   @default("execution")
  count       Int      @default(0)

  @@id([userId, windowStart, purpose])
}

// --- 運用ドメイン ---

enum ErrorLogSource {
  SERVER
  CLIENT
}

// 想定外エラーの収集ログ。サーバー側はinstrumentation.tsのonRequestErrorから、
// クライアント側はerror.tsx/global-error.tsxからPOST /api/client-errorsを経由して書き込む。
// ログ保存自体の失敗が本処理に影響しないよう、書き込みは常にbest-effort(失敗を握りつぶす)。
model ErrorLog {
  id      String         @id @default(cuid())
  source  ErrorLogSource
  message String         @db.Text
  digest  String?
  stack   String?        @db.Text
  path    String?
  method  String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --- AIコードレビュードメイン(Phase 2) ---
// GitHub OAuthのアクセストークンはNextAuthのAccount.access_tokenを再利用する
// (Phase 2用に別テーブルでトークンを持たない)。

// ユーザーがai-forgeに接続したGitHubリポジトリ。
model Repository {
  id            String  @id @default(cuid())
  githubRepoId  BigInt // GitHubのリポジトリID(名前変更に影響されない安定的な識別子)
  owner         String
  name          String
  defaultBranch String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviews Review[]

  connectedAt DateTime @default(now())

  @@unique([userId, githubRepoId])
}

enum ReviewStatus {
  PENDING
  SUCCESS
  FAILED
}

// PRに対するAIレビューの実行単位。実際のAI呼び出しはExecutionに委譲し、
// Reviewはその結果をどのリポジトリ・PRに対するものかという文脈に紐付ける。
model Review {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // どのプロンプト(バージョン)でレビューしたか。レビュー結果を後から追跡できるよう、
  // Executionと同様にPromptVersionを削除してもレビュー履歴は消えないようRestrictにする
  // (ExecutionはonDelete: Cascadeだが、Reviewは「傾向を可視化」する蓄積データのため
  // 実行ログより保持を優先する設計判断)。
  promptVersionId String
  promptVersion   PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)

  executionId String?    @unique
  execution   Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  pullRequestNumber Int
  pullRequestTitle  String
  pullRequestUrl    String
  headSha           String

  status ReviewStatus @default(PENDING)

  comments ReviewComment[]

  createdAt DateTime @default(now())

  @@index([repositoryId])
  @@index([userId])
}

enum ReviewCommentSeverity {
  INFO
  WARNING
  CRITICAL
}

// AIレビューが指摘した個別のコメント。Review.execution.resultTextから構造化して抽出する。
model ReviewComment {
  id String @id @default(cuid())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  filePath String
  line     Int?
  severity ReviewCommentSeverity @default(INFO)
  body     String                @db.Text

  embedding ReviewCommentEmbedding?

  createdAt DateTime @default(now())

  @@index([reviewId])
}

// --- RAG検索チャットボットドメイン(Phase 3) ---
// 埋め込みモデルはVoyage AI(voyage-3、1024次元)。詳細はdocs/phase3-design.mdを参照。
// pgvectorのvector型はPrismaが標準サポートしないためUnsupportedとして宣言しており、
// Prisma Clientの通常のSELECT/INSERTには含まれない。埋め込みの読み書き・類似検索は
// $queryRaw/$executeRawで行う(db-design.md参照)。

enum DocumentSourceType {
  MANUAL // Web画面から直接貼り付け
  REPO_FILE // リポジトリ内のファイルを同期
}

// 取り込んだドキュメント本体(設計書・手動メモ等)。検索対象のチャンクはDocumentChunkに持つ。
model Document {
  id         String             @id @default(cuid())
  title      String
  sourceType DocumentSourceType
  sourcePath String? // REPO_FILEの場合のみ設定。再同期時にこのパスのDocumentを上書きする
  content    String             @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chunks DocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sourcePath])
  @@index([userId])
}

// Documentを見出し単位で分割した1チャンク。類似検索のヒット単位。
model DocumentChunk {
  id         String @id @default(cuid())
  chunkIndex Int
  content    String @db.Text

  embedding Unsupported("vector(1024)")?

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([documentId])
}

// ReviewCommentへの埋め込みを1:1で追加する別テーブル。ReviewComment本体のスキーマ・
// 既存クエリへの影響を避けるためあえて分離している(db-design.md参照)。
model ReviewCommentEmbedding {
  reviewCommentId String        @id
  reviewComment   ReviewComment @relation(fields: [reviewCommentId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(1024)")?

  createdAt DateTime @default(now())
}

// --- RAG検索対象の拡張(Phase 4) ---
// PromptVersion・Executionのそれぞれへの埋め込みを1:1で追加する別テーブル。
// ReviewCommentEmbeddingと同じパターン(db-design.md参照)。

// PromptVersion.contentの埋め込み。新しいバージョンが保存されるたびに生成する
// (過去バージョンは差し替えない。バージョンごとに検索できるようにするため)。
model PromptVersionEmbedding {
  promptVersionId String        @id
  promptVersion   PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(1024)")?

  createdAt DateTime @default(now())
}

// Execution.resultTextの埋め込み。reviewIdが無い(Phase 2のレビュー実行ではない、
// Phase 1のプロンプト実行由来の)SUCCESSな実行のみを対象とする(docs/phase4-design.md参照)。
model ExecutionEmbedding {
  executionId String    @id
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(1024)")?

  createdAt DateTime @default(now())
}
